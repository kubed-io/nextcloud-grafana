<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="false"
	findUnusedCode="false"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
	errorBaseline="tests/psalm-baseline.xml">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<!--
		Load the nextcloud/ocp class definitions so Psalm resolves OCP\* symbols
		(IConfig, Files\Node, AppFramework\Controller, the Settings interfaces, …).
		Without this, Psalm reports every OCP reference as UndefinedClass /
		MissingDependency / UndefinedDocblockClass — ~176 false positives. We scan
		only the OCP package (not all of vendor) to keep analysis fast.
	-->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
	</extraFiles>
	<!--
		Hand-written stubs for the Server-app classes that live in a real Nextcloud
		but ship in neither nextcloud/ocp nor Composer: the Sabre WebDAV server
		(Sabre\DAV\*), the DAV connector's File node, and OCA\DAV\Events\SabrePluginAddEvent
		— all reached by the link-write guard plugin + its registration listener. Mirrors
		the n8n master's psalm.xml, which stubs the same DAV surface the same way.
	-->
	<stubs>
		<file name="tests/external-stubs.php" />
	</stubs>
	<issueHandlers>
		<!--
			These reference classes that exist at runtime in a real Nextcloud but are
			NOT shipped in nextcloud/ocp, so Psalm can't see them: the private OC
			internals the pull's mimetype repair-steps + Team Folder actor-FS setup
			reach for (`OC::$SERVERROOT`/`OC::$configDir`, `OC_Util::setupFS`). Not real
			bugs, and there's no public stub to import. Mirrors the n8n master's
			psalm.xml (which pulls the same private symbols) and integration_openai.
		-->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="OC" />
				<referencedClass name="OC_Util" />
			</errorLevel>
		</UndefinedClass>
		<!--
			MissingDependency doesn't support <referencedClass> in Psalm 6's schema.
			The only instances are IRootFolder reporting its base oc\hooks\emitter as
			missing — purely an OCP-stub artifact, not our code — so suppress the whole
			(low-value) issue type. Same as the master.
		-->
		<MissingDependency errorLevel="suppress" />
	</issueHandlers>
</psalm>
