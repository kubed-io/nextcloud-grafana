{
  "name": "grafana_sync",
  "version": "0.1.0",
  "description": "Grafana Sync — Nextcloud frontend (Files row icon + Open in Grafana action)",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "comment": "The POC src/files.js is a self-contained stub, so it pulls in no runtime deps yet. @nextcloud/files (v4 for NC33) + friends return when the Files-row action lands with the sync chapters.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "@nextcloud/event-bus": "^3.3.0",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.2.0",
    "@nextcloud/router": "^3.0.1"
  }
}
