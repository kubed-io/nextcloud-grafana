# Integration stack config — copy to .env, then `tests/integration/stack.sh up`.
# These same canonical values are mirrored into the CI services in
# .github/workflows/integration.yml (CI does not read this file; keep in sync).

# --- Nextcloud (autoinstall on first boot) ---
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=admin

# --- Grafana (ephemeral; admin creds bootstrap a service-account token) ---
# Grafana provisions its admin user from these env vars on first boot. Unlike
# n8n, Grafana HAS a headless token mint: with admin basic-auth you
#   POST /api/serviceaccounts        (create an Editor service account)
#   POST /api/serviceaccounts/{id}/tokens   (mint a token)
# so tests/integration/bin/mint-grafana-token.sh self-bootstraps the token the
# suite uses — no secret needs to be supplied.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
