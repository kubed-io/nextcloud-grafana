                        }
                      ]
                    },
                    {
                      "id": "custom.width",
                      "value": 330
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Healthy"
                  },
                  "properties": [
                    {
                      "id": "custom.cellOptions",
                      "value": {
                        "type": "color-text"
                      }
                    },
                    {
                      "id": "mappings",
                      "value": [
                        {
                          "options": {
                            "False": {
                              "color": "red",
                              "index": 1,
                              "text": "✗"
                            },
                            "True": {
                              "color": "green",
                              "index": 0,
                              "text": "✓"
                            },
                            "Unknown": {
                              "color": "orange",
                              "index": 2,
                              "text": "?"
                            }
                          },
                          "type": "value"
                        }
                      ]
                    },
                    {
                      "id": "custom.width",
                      "value": 80
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Runtime"
                  },
                  "properties": [
                    {
                      "id": "custom.cellOptions",
                      "value": {
                        "type": "color-text"
                      }
                    },
                    {
                      "id": "mappings",
                      "value": [
                        {
                          "options": {
                            "False": {
                              "color": "red",
                              "index": 1,
                              "text": "✗"
                            },
                            "True": {
                              "color": "green",
                              "index": 0,
                              "text": "✓"
                            },
                            "Unknown": {
                              "color": "orange",
                              "index": 2,
                              "text": "?"
                            }
                          },
                          "type": "value"
                        }
                      ]
                    },
                    {
                      "id": "custom.width",
                      "value": 80
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "State"
                  },
                  "properties": [
                    {
                      "id": "custom.cellOptions",
                      "value": {
                        "type": "color-text"
                      }
                    },
                    {
                      "id": "mappings",
                      "value": [
                        {
                          "options": {
                            "Active": {
                              "color": "green",
                              "index": 0
                            },
                            "Inactive": {
                              "color": "text",
                              "index": 1
                            }
                          },
                          "type": "value"
                        }
                      ]
                    },
                    {
                      "id": "custom.width",
                      "value": 90
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Number"
                  },
                  "properties": [
                    {
                      "id": "custom.width",
                      "value": 80
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Created"
                  },
                  "properties": [
                    {
                      "id": "unit",
                      "value": "dateTimeFromNow"
                    },
                    {
                      "id": "custom.width",
                      "value": 120
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "path"
                  },
                  "properties": [
                    {
                      "id": "custom.hideFrom.viz",
                      "value": true
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "panel-21": {
      "kind": "Panel",
      "spec": {
        "id": 21,
        "title": "Definitions",
        "description": "CompositeResourceDefinitions. Versions marked * are the referenceable one compositions use.\n\n**Careful:** Established False means Crossplane is not serving the kind - every composite of it is stuck.",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "yesoreyeram-infinity-datasource",
                    "version": "v0",
                    "datasource": {
                      "name": "kubernetes"
                    },
                    "spec": {
                      "columns": [],
                      "filters": [],
                      "format": "table",
                      "parser": "jq-backend",
                      "root_selector": "def epoch: if . == null then null else sub(\"\\\\.[0-9]+\"; \"\") | fromdateiso8601 * 1000 end;\ndef cond($t): (.status.conditions // []) | map(select(.type == $t)) | .[0] // {};\n[.items[] | . as $x\n| {Kind: $x.spec.names.kind, Definition: $x.metadata.name, Group: $x.spec.group,\nVersions: ([$x.spec.versions[] | select(.served) | .name + (if .referenceable then \"*\" else \"\" end)] | join(\" \")),\nScope: ($x.spec.scope // \"Cluster\"), Claim: ($x.spec.claimNames.kind // \"\"),\nEstablished: (($x | cond(\"Established\")).status // \"Unknown\"),\nDefault: ($x.spec.defaultCompositionRef.name // \"\"),\nCreated: ($x.metadata.creationTimestamp | epoch)}]",
                      "source": "url",
                      "type": "json",
                      "url": "https://kubernetes.default.svc/apis/apiextensions.crossplane.io/v2/compositeresourcedefinitions",
                      "url_options": {
                        "headers": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "method": "GET"
                      }
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [
