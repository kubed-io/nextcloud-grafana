                "group": "organize",
                "spec": {
                  "options": {
                    "excludeByName": {},
                    "indexByName": {
                      "Claim": 5,
                      "Created": 8,
                      "Default": 7,
                      "Definition": 1,
                      "Established": 6,
                      "Group": 2,
                      "Kind": 0,
                      "Scope": 4,
                      "Versions": 3
                    },
                    "renameByName": {}
                  }
                }
              }
            ],
            "queryOptions": {}
          }
        },
