                "custom": {
                  "align": "auto",
                  "cellOptions": {
                    "type": "auto"
                  },
                  "filterable": true,
                  "inspect": false,
                  "minWidth": 50
                }
              },
              "overrides": [
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Revision"
                  },
                  "properties": [
                    {
                      "id": "links",
                      "value": [
