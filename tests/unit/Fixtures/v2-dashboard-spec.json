  "cursorSync": "Crosshair",
  "description": "Crossplane 2 in namespace crossplane: core (composite, package and revision controllers), the RBAC manager, and the packages it installed - Providers reconcile managed resources against an outside API (only provider-opentofu here: every managed resource is an OpenTofu Workspace), Functions run the steps of each Composition's pipeline (go-templating, patch-and-transform). The kubed.io definitions (LDAP, Keycloak, PostgreSQL, GCP) are the APIs apps use; each composite renders through its Composition into Workspaces. Metrics are core's and the packages' own (controller_runtime_*, function_run_function_*, circuit_breaker_events_total, crossplane_managed_resource_*), scraped since 2026-10-06 by PodMonitor crossplane. Packages, API, Composites, Engine, Functions, Managed, Workload, Logs and Resources are tabs; a tab only queries while it is open.",
  "editable": true,
  "elements": {
    "panel-11": {
      "kind": "Panel",
      "spec": {
        "id": 11,
        "title": "Revisions",
        "description": "Every package revision. Crossplane keeps the previous one Inactive (revisionHistoryLimit) so an upgrade can roll back by flipping which revision is Active.\n\n**Careful:** Healthy is the package itself; Runtime is its pod.",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "yesoreyeram-infinity-datasource",
                    "version": "v0",
                    "datasource": {
                      "name": "kubernetes"
                    },
                    "spec": {
                      "columns": [],
                      "filters": [],
                      "format": "table",
                      "pagination_max_pages": 50,
                      "pagination_mode": "list",
                      "pagination_param_list_field_name": "P",
                      "pagination_param_list_field_type": "replace",
                      "pagination_param_list_value": "apis/pkg.crossplane.io/v1/providerrevisions,apis/pkg.crossplane.io/v1/functionrevisions,apis/pkg.crossplane.io/v1/configurationrevisions",
                      "parser": "jq-backend",
                      "root_selector": "def epoch: if . == null then null else sub(\"\\\\.[0-9]+\"; \"\") | fromdateiso8601 * 1000 end;\ndef cond($t): (.status.conditions // []) | map(select(.type == $t)) | .[0] // {};\n[.items[] | . as $r | ($r.kind | sub(\"Revision$\"; \"\")) as $k\n| {Package: ($r.metadata.labels[\"pkg.crossplane.io/package\"] // \"\"), Kind: $k, Revision: $r.metadata.name,\nImage: ($r.spec.image // $r.spec.packageImage // \"\" | sub(\"^.*/\"; \"\")), Number: ($r.spec.revision // 0), State: ($r.spec.desiredState // \"\"),\nHealthy: (($r | cond(\"RevisionHealthy\")).status // \"Unknown\"), Runtime: (($r | cond(\"RuntimeHealthy\")).status // \"Unknown\"),\npath: \"apis/pkg.crossplane.io/v1/\\($r.kind | ascii_downcase)s/\\($r.metadata.name)\",\nCreated: ($r.metadata.creationTimestamp | epoch)}]\n| if length == 0 then [{Package: \"\", Kind: \"\", Revision: \"\", Image: \"\", Number: 0, State: \"\", Healthy: \"\", Runtime: \"\", path: \"\", Created: 0}] else . end",
                      "source": "url",
                      "type": "json",
                      "url": "https://kubernetes.default.svc/${__pagination.P}",
                      "url_options": {
                        "headers": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "method": "GET"
                      }
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [
              {
                "kind": "Transformation",
                "group": "filterByValue",
                "spec": {
                  "options": {
                    "filters": [
                      {
                        "config": {
                          "id": "equal",
                          "options": {
                            "value": ""
                          }
                        },
                        "fieldName": "Revision"
                      }
                    ],
                    "match": "all",
                    "type": "exclude"
                  }
                }
              },
              {
                "kind": "Transformation",
                "group": "organize",
                "spec": {
                  "options": {
                    "excludeByName": {},
                    "indexByName": {
                      "Created": 8,
                      "Healthy": 5,
                      "Image": 7,
                      "Kind": 1,
                      "Number": 3,
                      "Package": 0,
                      "Revision": 2,
                      "Runtime": 6,
                      "State": 4
                    },
                    "renameByName": {}
                  }
                }
              }
            ],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "table",
          "version": "13.2.1",
          "spec": {
            "options": {
              "cellHeight": "sm",
              "enablePagination": false,
